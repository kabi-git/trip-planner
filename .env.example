# ── Database ──────────────────────────────────────────────────────────────────
# Turso cloud SQLite (get from: https://turso.tech → your database → Connect)
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your-turso-auth-token

# For local Bun dev without Turso, leave these unset — falls back to file:./data/trips.db

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-strong-password
DEVA_PASSWORD=change-me-viewer-password
